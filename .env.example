# Origins allowed to call the API from a browser, comma separated.
PYRAIZ_CORS_ORIGINS=http://localhost:3000
PYRAIZ_API_ORIGIN=http://localhost:8000
# Relative SQLite path is resolved from backend/ when starting the API there.
PYRAIZ_DATABASE_URL=sqlite:///./pyraiz.db
PYRAIZ_ENV=development
PYRAIZ_COOKIE_SECURE=false
